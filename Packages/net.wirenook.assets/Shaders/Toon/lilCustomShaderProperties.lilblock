        // Wirenook (custom.hlsl beside this file says what each does)
                        _WirenookGlitch             ("Glitch", Range(0, 1)) = 0
                        _WirenookScreen             ("Screen", Range(0, 1)) = 0
                        _WirenookScreenTile         ("Screen Tile", Float) = -1
                        _WirenookSign               ("Sign", Float) = 0
                        _WirenookSignShow           ("Sign Show", Range(0, 2)) = 0
                        _WirenookSignB              ("Sign B", Float) = 0
                        _WirenookSignBShow          ("Sign B Show", Range(0, 2)) = 0
                        _WirenookSignC              ("Sign C", Float) = 0
                        _WirenookSignCShow          ("Sign C Show", Range(0, 2)) = 0
